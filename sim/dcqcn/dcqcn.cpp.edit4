// -*- c-basic-offset: 4; indent-tabs-mode: nil -*-
#include "dcqcn.h"

#include <math.h>
#include <stdio.h>

#include <algorithm>
#include <iostream>

#include "queue.h"
#include "switch.h"
#include "trigger.h"
using namespace std;

////////////////////////////////////////////////////////////////
//  DCQCN SOURCE/SINK STATICS
////////////////////////////////////////////////////////////////

/* keep track of RTOs.  Generally, we shouldn't see RTOs if
   return-to-sender is enabled.  Otherwise we'll see them with very
   large incasts. */
simtime_picosec DCQCNSink::_cnp_interval =
    timeFromUs(50.0);  // slightly slower CNPs for stability at high starts

// Control loop tick (both T and k timers piggyback on this)
simtime_picosec DCQCNSrc::_cc_update_period = timeFromUs(15000.0);  // ~15ms WAN epoch

// DCQCN state (α EWMA, etc.)
double   DCQCNSrc::_alpha = 1;
double   DCQCNSrc::_g     = 1.0 / 256;        // α EWMA decay (k-timer)
uint64_t DCQCNSrc::_B     = 64 * 1024 * 1024; // bytes-per-epoch for BC (64MB)

uint32_t      DCQCNSrc::_F    = 20;  // epochs before hyper-increase eligible
linkspeed_bps DCQCNSrc::_RAI  = 0;   // per-instance (depends on link/rate)
linkspeed_bps DCQCNSrc::_RHAI = 0;

// Tunables not in the original paper (WAN-safety knobs)
double   DCQCNSrc::_rate_floor_frac            = 0.10; // keep at least 10% of line
double   DCQCNSrc::_md_alpha_cap               = 0.25; // cap α used in a single MD
uint32_t DCQCNSrc::_hi_cooldown_epochs_default = 2;    // epochs of AI-only after MD
bool     DCQCNSrc::_one_md_per_epoch           = true; // ignore stacked CNPs in same epoch

////////////////////////////////////////////////////////////////
//  DCQCN SOURCE
////////////////////////////////////////////////////////////////

DCQCNSrc::DCQCNSrc(RoceLogger*    logger,
                   TrafficLogger* pktlogger,
                   EventList&     eventlist,
                   linkspeed_bps  linkspeed,
                   linkspeed_bps  rate,
                   ofstream&      statistics_outfile)
    : RoceSrc(logger, pktlogger, eventlist, rate, statistics_outfile) {
    _cnps_received = 0;

    // link speed and initial rates
    _link = linkspeed;
    _RC   = rate;  // current transmit rate
    _RT   = rate;  // target transmit rate

    // WAN-friendly growth for high starting rates: smaller steps to avoid overshoot
    _RAI  = std::max<linkspeed_bps>(_link / 192, rate / 48);
    _RHAI = std::max<linkspeed_bps>(_link / 128, rate / 32);

    _last_cc_update    = 0;
    _last_alpha_update = 0;

    _T                = 0;
    _BC               = 0;
    _byte_counter     = 0;
    _old_highest_sent = 0;

    // Stability helpers
    _hi_cooldown_epochs = 0;
    _last_md_epoch      = -1;
    _cnps_received_total = 0;
}

void DCQCNSrc::processCNP(const CNPPacket& /*cnp*/) {
    _cnps_received++;
    _cnps_received_total++;

    // Optional: only one MD per control epoch to avoid compounded cuts
    if (_one_md_per_epoch && _last_md_epoch == _T) {
        _alpha = (1 - _g) * _alpha + _g;  // still let α rise on marks
        return;
    }

    _RT = _RC;

    // Floor keeps some pacing after a storm, but below fair-share so we can converge
    const linkspeed_bps floor_rate =
        std::max<linkspeed_bps>(1, static_cast<linkspeed_bps>(_link * _rate_floor_frac));

    // Clamp MD severity per CNP
    const double md_alpha = std::min(_md_alpha_cap, _alpha);

    _RC = std::max<linkspeed_bps>(
        static_cast<linkspeed_bps>(_RC * (1.0 - md_alpha / 2.0)),
        floor_rate);

    // α EWMA (k-timer handled by periodic tick)
    _alpha = (1 - _g) * _alpha + _g;

    // Reset Stage-2 counters; start a brief HI cooldown
    _T                = 0;
    _BC               = 0;
    _byte_counter     = 0;
    _old_highest_sent = _highest_sent;
    _hi_cooldown_epochs = _hi_cooldown_epochs_default;
    _last_md_epoch      = _T;  // currently 0 after reset

    _pacing_rate = _RC;
    update_spacing();

    cout << "[MD] t=" << timeAsUs(eventlist().now())
         << " flow=" << _name
         << " RC=" << _RC << " RT=" << _RT
         << " alpha=" << _alpha
         << " cnp_total=" << _cnps_received_total
         << " floor=" << static_cast<linkspeed_bps>(_link * _rate_floor_frac)
         << endl;

    _last_cc_update    = eventlist().now();
    _last_alpha_update = eventlist().now();

    eventlist().sourceIsPendingRel(*this, _cc_update_period);
}

void DCQCNSrc::increaseRate() {
    if (_RC >= _link) return;  // already at line rate

    const bool in_cooldown = (_hi_cooldown_epochs > 0);

    if (std::max(_T, _BC) <= _F) {
        // Fast recovery: jump half-way toward the target
        _RC = (_RT + _RC) / 2;

    } else if (!in_cooldown && std::min(_T, _BC) > _F) {
        // Hyper-increase: conservative for WAN; tightly cap per-tick jump
        linkspeed_bps steps = (std::min(_T, _BC) - _F);
        linkspeed_bps delta = steps * _RHAI;
        delta = std::min<linkspeed_bps>(delta, _link / 256);
        _RT  += delta;
        _RC   = (_RT + _RC) / 2;

    } else {
        // Additive increase
        _RT += _RAI;
        _RC  = (_RT + _RC) / 2;
    }

    if (_RC > _link) _RC = _link;

    _pacing_rate = _RC;
    update_spacing();

    cout << "At " << timeAsUs(eventlist().now()) << " RC=" << _RC
         << " RT=" << _RT
         << " node=" << nodename()
         << " spacing(us)=" << timeAsUs(_packet_spacing)
         << " T=" << _T << " BC=" << _BC
         << " bytes_in_epoch=" << _byte_counter
         << " alpha=" << _alpha
         << " HI_cooldown=" << _hi_cooldown_epochs
         << endl;
}

void DCQCNSrc::doNextEvent() {
    bool reschedule = false;

    // opportunistic sending-rate logging
    if (rand() % 1000 < 5) {
        if (_state_send == PAUSED) {
            _statistics_outfile << "Flow " << _name << " time: " << timeAsUs(eventlist().now())
                                << " sending_rate: " << 0 << endl;
        } else {
            _statistics_outfile << "Flow " << _name << " time: " << timeAsUs(eventlist().now())
                                << " sending_rate: " << _pacing_rate << endl;
        }
    }

    if (_done) {
        cout << "DCQCNSrc: flow_id: " << _name << " is done, not sending more packets\n";
        return;
    }

    RoceSrc::doNextEvent();

    // Track bytes to drive BC
    _byte_counter += (_highest_sent - _old_highest_sent) * _mss;
    _old_highest_sent = _highest_sent;

    if (_byte_counter >= _B) {
        _byte_counter = 0;
        _BC++;
        increaseRate();
        reschedule = true;
    }

    // α decay (k-timer)
    if (eventlist().now() - _last_alpha_update >= _cc_update_period) {
        _alpha     = (1 - _g) * _alpha;
        _last_alpha_update = eventlist().now();
        reschedule = true;
    }

    // Rate-increase epoch tick (t-timer)
    if (eventlist().now() - _last_cc_update >= _cc_update_period) {
        _last_cc_update = eventlist().now();
        _T++;
        if (_hi_cooldown_epochs > 0) _hi_cooldown_epochs--;
        increaseRate();
        reschedule = true;
    }

    if (reschedule)
        eventlist().sourceIsPendingRel(*this, _cc_update_period);
}

void DCQCNSrc::receivePacket(Packet& pkt) {
    if (!_flow_started) {
        assert(pkt.type() == ETH_PAUSE);
        return;
    }

    if (_stop_time && eventlist().now() >= _stop_time) {
        // stop sending new data, but allow us to finish any retransmissions
        _flow_size = _highest_sent * _mss + _mss;
        _stop_time = 0;
    }

    if (_done) return;

    switch (pkt.type()) {
        case ETH_PAUSE:
            processPause((const EthPausePacket&)pkt);
            pkt.free();
            return;
        case ROCENACK:
            _nacks_received++;
            processNack((const RoceNack&)pkt);
            pkt.free();
            return;
        case ROCEACK:
            _acks_received++;
            processAck((const RoceAck&)pkt);
            pkt.free();
            return;
        case CNP:
            processCNP((const CNPPacket&)pkt);
            pkt.free();
            return;
        default:
            abort();
    }
}

////////////////////////////////////////////////////////////////
//  DCQCN SINK
////////////////////////////////////////////////////////////////

/* Only use this constructor when there is only one flow to this receiver */
DCQCNSink::DCQCNSink(EventList& eventlist, ofstream& statistics_outfile)
    : RoceSink(eventlist, statistics_outfile) {
    _last_cnp_sent_time            = UINT64_MAX;
    _marked_packets_since_last_cnp = 0;
    _packets_since_last_cnp        = 0;
    _ecn_marked_total              = 0;
    _cnp_sent_total                = 0;
}

// Receive a packet.
// Note: _cumulative_ack is the last byte we've ACKed.
// seqno is the first byte of the new packet.
void DCQCNSink::receivePacket(Packet& pkt) {
    bool ecn_marked = ((pkt.flags() & ECN_CE) != 0);
    RoceSink::receivePacket(pkt);

    if (ecn_marked) {
        _ecn_marked_total++;
        cout << "DCQCNSink received ECN marked packet at "
             << timeAsUs(eventlist().now())
             << " ecn_marked_total=" << _ecn_marked_total
             << " -> CNP?" << endl;

        // generate CNPs here.
        if (_last_cnp_sent_time == UINT64_MAX ||
            eventlist().now() - _last_cnp_sent_time >= _cnp_interval) {
            send_cnp();
            eventlist().sourceIsPendingRel(*this, _cnp_interval);
        } else {
            _marked_packets_since_last_cnp++;
        }
    }
    _packets_since_last_cnp++;
}

void DCQCNSink::doNextEvent() {
    if (eventlist().now() - _last_cnp_sent_time >= _cnp_interval &&
        _marked_packets_since_last_cnp > 0) {
        send_cnp();
        eventlist().sourceIsPendingRel(*this, _cnp_interval);
    }
}

void DCQCNSink::send_cnp() {
    CNPPacket* cnp = CNPPacket::newpkt(_src->_flow, *_route, _cumulative_ack, _srcaddr);
    cnp->set_pathid(0);
    cnp->sendOn();

    _last_cnp_sent_time            = eventlist().now();
    _packets_since_last_cnp        = 0;
    _marked_packets_since_last_cnp = 0;
    _cnp_sent_total++;

    cout << "CNP sent at " << timeAsUs(_last_cnp_sent_time)
         << " total_cnp_sent=" << _cnp_sent_total
         << " total_ecn_marked=" << _ecn_marked_total
         << " flow=" << _src->_name << endl;
}
